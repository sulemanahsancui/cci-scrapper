{
  "name": "scraping-automation-framework",
  "version": "1.0.0",
  "description": "Production-grade scraping & browser automation starter kit",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "api": "node src/api/server.js",
    "fleet": "node run-cci-fleet.js",
    "fleet:reset": "node scripts/reset-cci-run.js --yes",
    "fleet:merge": "node scripts/merge-cci-output.js",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/database/seeds/initial.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "lint": "eslint src/ --ext .js"
  },
  "dependencies": {
    "playwright": "^1.44.0",
    "playwright-extra": "^4.3.6",
    "puppeteer": "^22.9.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "axios": "^1.7.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "pg": "^8.11.5",
    "pg-pool": "^3.6.2",
    "bullmq": "^5.8.2",
    "ioredis": "^5.4.1",
    "node-cron": "^3.0.3",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0",
    "axios-retry": "^4.4.0",
    "csv-stringify": "^6.5.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "p-limit": "^6.1.0",
    "p-retry": "^6.2.0",
    "@2captcha/captcha-solver": "^1.1.3",
    "tough-cookie": "^4.1.4",
    "user-agents": "^1.1.261",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.4",
    "socks-proxy-agent": "^8.0.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "eslint": "^9.3.0",
    "@jest/globals": "^29.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
